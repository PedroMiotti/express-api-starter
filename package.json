{
  "name": "nk-api-name",
  "version": "1.0.0",
  "description": "Nuki <name> API",
  "main": "index.js",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.cjs",
    "prepare": "[ -d .git ] && simple-git-hooks || true",
    "dev": "tsx watch src/index.ts",
    "dev:debugger": "tsx watch --inspect src/index.ts",
    "build": "tsc",
    "start": "node build/src/index.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "ci:check": "biome ci .",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seeds/user.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "pnpm": ">=10.28.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "jest": "^29.3.1",
    "jest-mock-extended": "^3.0.1",
    "jsonwebtoken": "^9.0.3",
    "morphism": "^1.12.3",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.20.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@swc/core": "^1.15.26",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.14",
    "@types/jest": "^29.4.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^18.11.17",
    "module-alias": "^2.2.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.7.0",
    "simple-git-hooks": "^2.13.1",
    "ts-jest": "^29.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "_moduleAliases": {
    "@": "./build/src"
  }
}
